if(NOT MIDI_SOURCE)
    message(FATAL_ERROR "MIDI_SOURCE is required")
endif()
file(READ "${MIDI_SOURCE}/CMakeLists.txt" build_source)
file(READ "${MIDI_SOURCE}/cmake/iiCSMIDIConfig.cmake.in" package_source)
file(READ "${MIDI_SOURCE}/src/MidiDocument.h" public_source)
file(READ "${MIDI_SOURCE}/src/MidiDocument.cpp" implementation_source)
foreach(source IN ITEMS build_source package_source public_source implementation_source)
    if("${${source}}" MATCHES "iiSDKCore|iiFileProvider|iiJson")
        message(FATAL_ERROR "MIDI SDK must not import another SDK: ${source}")
    endif()
endforeach()
