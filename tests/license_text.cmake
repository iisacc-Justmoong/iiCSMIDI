if(NOT SOURCE OR NOT PACKAGE_CONFIG)
    message(FATAL_ERROR "SOURCE and PACKAGE_CONFIG are required")
endif()

function(require_text path needle description)
    file(READ "${path}" body)
    string(FIND "${body}" "${needle}" found)
    if(found LESS 0)
        message(FATAL_ERROR "${description}: ${path}")
    endif()
endfunction()

function(reject_text path needle description)
    file(READ "${path}" body)
    string(FIND "${body}" "${needle}" found)
    if(NOT found LESS 0)
        message(FATAL_ERROR "${description}: ${path}")
    endif()
endfunction()

require_text("${SOURCE}/LICENSE" "Apache License" "LICENSE must be the Apache License")
require_text("${SOURCE}/LICENSE" "Version 2.0, January 2004" "LICENSE must be Apache-2.0")
require_text("${SOURCE}/LICENSE" "END OF TERMS AND CONDITIONS" "LICENSE must include the Apache terms")
reject_text("${SOURCE}/LICENSE" "MIT License" "LICENSE must not keep an MIT claim")
reject_text("${SOURCE}/LICENSE" "Permission is hereby granted" "LICENSE must not keep the MIT grant")

require_text("${SOURCE}/NOTICE" "Copyright (c) 2026 iisacc" "NOTICE must carry the iisacc copyright")
require_text("${SOURCE}/NOTICE" "Apache License" "NOTICE must name the Apache License")

require_text("${SOURCE}/README.md" "SPDX-License-Identifier: Apache-2.0" "README SPDX identifier must be Apache-2.0")
reject_text("${SOURCE}/README.md" "SPDX-License-Identifier: MIT" "README must not keep an MIT SPDX identifier")
reject_text("${SOURCE}/README.md" "MIT License" "README must not keep an MIT license claim")

require_text("${SOURCE}/docs/License.md" "SPDX-License-Identifier: Apache-2.0" "Korean license SPDX identifier must be Apache-2.0")
require_text("${SOURCE}/AGENT.md" "Apache License 2.0" "AGENT.md must state Apache-2.0")
require_text("${SOURCE}/CMakeLists.txt" "set(iiCSMIDI_SPDX_LICENSE \"Apache-2.0\")" "CMake project must set the SPDX variable")
require_text("${SOURCE}/CMakeLists.txt" "install(FILES README.md LICENSE NOTICE" "Install rule must copy LICENSE and NOTICE")
require_text("${SOURCE}/cmake/iiCSMIDIConfig.cmake.in" "set(iiCSMIDI_SPDX_LICENSE \"Apache-2.0\")" "Package template must export the SPDX variable")
require_text("${PACKAGE_CONFIG}" "set(iiCSMIDI_SPDX_LICENSE \"Apache-2.0\")" "Generated package config must export the SPDX variable")
require_text("${SOURCE}/example/CoreAsync/cmake/iiCSMIDIAsyncConfig.cmake.in" "set(iiCSMIDIAsync_SPDX_LICENSE \"Apache-2.0\")" "Async package template must export the SPDX variable")
