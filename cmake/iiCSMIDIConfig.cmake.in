@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}/../iiFileProvider" "$ENV{HOME}/.local/SDK/iiFileProvider")
find_dependency(iiFileProvider 0.2.0 CONFIG REQUIRED)
find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core)
include("${CMAKE_CURRENT_LIST_DIR}/iiCSMIDITargets.cmake")
check_required_components(iiCSMIDI)
