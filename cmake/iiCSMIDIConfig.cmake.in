@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(iiSDKCore 0.14 CONFIG COMPONENTS Contracts)
find_dependency(iiFileProviderNative 0.8 CONFIG)
find_dependency(iiJson 0.1 CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/iiCSMIDITargets.cmake")
foreach(_component IN LISTS iiCSMIDI_FIND_COMPONENTS)
    if(_component STREQUAL "Async")
        find_dependency(iiSDKCore 0.14 CONFIG COMPONENTS Runtime)
        include("${CMAKE_CURRENT_LIST_DIR}/iiCSMIDIAsyncTargets.cmake")
        set(iiCSMIDI_Async_FOUND TRUE)
    else()
        set(iiCSMIDI_${_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(iiCSMIDI)
